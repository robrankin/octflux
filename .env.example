# Copy to .env (gitignored). Secrets + deployment values; read by docker-compose
# and interpolated into config.yaml as ${VAR}. config.yaml holds behaviour (what to
# collect, where it goes); this file holds the credentials and host-specific bits.

# --- Octopus account (required) ---
OCTOPUS_API_KEY=sk_live_your_octopus_key_here
OCTOPUS_ACCOUNT_NUMBER=A-XXXXXXXX

# --- TimescaleDB (required; used by the db + octflux containers and the DSN) ---
POSTGRES_USER=octflux
POSTGRES_PASSWORD=change-me            # REQUIRED — the stack refuses to start unset
POSTGRES_DB=octflux

# --- Host port mappings (optional; defaults shown) ---
OCTFLUX_HTTP_PORT=8088                 # REST /api/v1 + MCP on the host
OCTFLUX_DB_PORT=5433                   # TimescaleDB exposed on the host (for pgAdmin etc.)

# --- Optional MQTT sink (only if the broker sink is enabled in config.yaml) ---
# MQTT_HOST=192.0.2.10
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# --- Optional: run Alembic from the host, or provision Grafana yourself ---
# OCTFLUX_DB_URL=postgresql+psycopg://octflux:change-me@localhost:5433/octflux
# OCTFLUX_DB_HOST=127.0.0.1            # for grafana/provisioning datasource
